# QuoteDesk environment. Copy to .env and fill in. Never commit .env.
# All data sent to any LLM is synthetic. The company and products are fictional.

# ---------- LLM provider ----------
LLM_PROVIDER=kie                      # kie | google
KIE_API_KEY=                          # https://kie.ai/api-key
KIE_BASE_URL=https://api.kie.ai
GEMINI_API_KEY=                       # only if LLM_PROVIDER=google (free AI Studio key, no billing)

GEMINI_MODEL=gemini-3-8-flash         # teacher; on Google use gemini-3.8-flash
GEMINI_DATAGEN_MODEL=gemini-3-8-flash # email writer
GEMINI_VERIFY_MODEL=gemini-3-7-flash  # independent verifier (different model)
GEMINI_THINKING_LEVEL=low

LLM_MAX_CONCURRENCY=4                 # KIE: 20 req / 10 s. Free Google tier: 1
LLM_MIN_INTERVAL_S=0.6                # Free Google tier: 6

# ---------- Data generation ----------
DATAGEN_BATCH_SIZE=5
DATAGEN_SEED=42
DATAGEN_MAX_CREDITS=                  # hard stop on KIE spend; set after the pilot

# ---------- Student model ----------
HF_TOKEN=                             # write scope; also a Kaggle notebook secret + Modal secret
HF_MODEL_REPO=your-hf-user/quotedesk-student
STUDENT_BASE_MODEL=unsloth/gemma-3-270m-it   # same weights as google/gemma-3-270m-it (ungated mirror)
STUDENT_ADAPTER_REVISION=             # e.g. v1; empty = teacher-only mode
STUDENT_QUANTIZE=                     # empty (fp32) or int8: ~30% faster on CPU; enable only if eval shows no accuracy loss
HF_HOME=                              # on Modal: /cache/hf (inside the Volume)

# ---------- Backend ----------
DATABASE_URL=sqlite:///./quotedesk.db # Neon: postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
ADMIN_TOKEN=                          # python -c "import secrets;print(secrets.token_urlsafe(32))"
ROUTER_CONFIDENCE_THRESHOLD=          # set in P4 from the calibration sweep, never guessed
TEACHER_LIVE_MODE=admin_only          # off | admin_only | all
MAX_EMAIL_CHARS=6000
RATE_LIMIT=10/minute
REQUEST_TIMEOUT_S=30
MAX_COST_PER_REQUEST_USD=0.01
ALLOWED_ORIGINS=http://localhost:3000 # comma-separated; add the Vercel URL in prod

# ---------- Retraining ----------
RETRAIN_THRESHOLD=20                  # v1.1
PROMOTION_MARGIN=0.0                  # v1.1
AUTO_RETRAIN_ENABLED=false            # v1.2
KAGGLE_API_TOKEN=                     # v1.2 only, if the Kaggle path is chosen
KAGGLE_USERNAME=                      # legacy auth alternative to KAGGLE_API_TOKEN
KAGGLE_KEY=
KAGGLE_DATASET_SLUG=your-kaggle-user/quotedesk-data
KAGGLE_KERNEL_SLUG=your-kaggle-user/quotedesk-finetune

# ---------- Frontend (frontend/.env.local) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # prod: https://<workspace>--quotedesk-web.modal.run

# Modal auth is NOT stored here: run `modal setup` (writes ~/.modal.toml).
